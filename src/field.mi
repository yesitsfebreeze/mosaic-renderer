package main

use core:math

GRID_SIZE :: 32
CELL_COUNT :: GRID_SIZE * GRID_SIZE * GRID_SIZE
MATERIAL_COUNT :: 256
MATERIAL_WORDS :: 8
CUBE_SIZE :: f32(10)

# Shared with shaders/voxel.frag: one word per cell followed by the material table.
# A cell stores material in bits 0..7 and shape in bits 8..15. Material zero is air.
# Shape zero is full; 1..26 keeps dot(normal, local_position - 0.5) <= 0.
Field :: struct
    words: []u32,

proc shape_normal(shape: u32) -> [3]int
    assert(shape >= 1 && shape <= 26)
    k := int(shape - 1)
    if k >= 13: k += 1
    return {k % 3 - 1, k / 3 % 3 - 1, k / 9 - 1}

proc field_put(f: ^Field, x, y, z: int, material: u32, shape: u32 = 0)
    assert(x >= 0 && x < GRID_SIZE && y >= 0 && y < GRID_SIZE && z >= 0 && z < GRID_SIZE)
    assert(material < MATERIAL_COUNT && shape <= 26)
    f.words[x + GRID_SIZE * (y + GRID_SIZE * z)] = material | (shape << 8)

proc material_put(f: ^Field, id: int, color: [3]f32, metallic: f32 = 0, roughness: f32 = 0.65, emission: f32 = 0)
    assert(id >= 0 && id < MATERIAL_COUNT)
    alpha: f32 = 0 if id == 0 else 1
    values := [8]f32{
        math.pow(color.r, 2.2), math.pow(color.g, 2.2), math.pow(color.b, 2.2), alpha,
        metallic, roughness, emission, 0.04,
    }
    first := CELL_COUNT + id * MATERIAL_WORDS
    for value, i in values: f.words[first + i] = transmute(u32, value)

proc field_generate(f: ^Field)
    f.words = make([]u32, CELL_COUNT + MATERIAL_COUNT * MATERIAL_WORDS)
    for id in 0 ..< MATERIAL_COUNT
        color := [3]f32{
            0.24 + 0.70 * f32((id >> 5) & 7) / 7,
            0.24 + 0.70 * f32((id >> 2) & 7) / 7,
            0.24 + 0.70 * f32(id & 3) / 3,
        }
        material_put(f, id, color)
    material_put(f, 0, {0, 0, 0})
    material_put(f, 1, {0.18, 0.20, 0.23}, 0, 0.9)
    material_put(f, 2, {0.38, 0.42, 0.47}, 0, 0.8)
    material_put(f, 3, {0.94, 0.69, 0.24}, 0.8, 0.22)

    # The floor and pedestals make the extent of each single-cell half shape visible.
    for z in 1 ..< GRID_SIZE - 1
        for x in 1 ..< GRID_SIZE - 1
            field_put(f, x, 1, z, 1)
    for i in 0 ..< 26
        x := 3 + i % 6 * 5
        z := 3 + i / 6 * 5
        for y in 2 ..< 5: field_put(f, x, y, z, 2)
        field_put(f, x, 5, z, u32(16 + i * 7), u32(i + 1))

    # A full-cell reference and two adjoining diagonal halves exercise shared boundaries.
    for y in 2 ..< 10: field_put(f, 27, y, 27, 3)
    field_put(f, 15, 2, 28, 3, 17)
    field_put(f, 16, 2, 28, 3, 17)

proc field_destroy(f: ^Field)
    delete(f.words)
    f.words = nil
