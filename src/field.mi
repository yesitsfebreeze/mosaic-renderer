package main

import "core:math"

GRID_SIZE :: 32
CELL_COUNT :: GRID_SIZE * GRID_SIZE * GRID_SIZE
COLUMN_COUNT :: 3 * GRID_SIZE * GRID_SIZE
MATERIAL_COUNT :: 256
MATERIAL_WORDS :: 8
HEADER_WORDS :: 16
RUN_WORDS :: 4
PROPERTY_WORDS :: 20
DEPTH_SCALE :: 256
CUBE_SIZE :: f32(10)

Field :: struct
    words: []u32,

# CPU construction scratch only. The GPU receives the packed RLE and lookup tables.
Field_Cell :: struct
    material: u32,
    state: u32,
    lower: [3]u32,
    upper: [3]u32,

Field_State :: struct
    first: u32,
    count: u32,

Field_Property :: struct
    id: u32,
    components: u32,
    base: [4]f32,
    gradient_x: [4]f32,
    gradient_y: [4]f32,
    gradient_z: [4]f32,

proc field_put_bounds(cells: []Field_Cell, x, y, z: int, material, state: u32, lower, upper: [3]u32)
    assert(len(cells) == CELL_COUNT)
    assert(x >= 0 && x < GRID_SIZE && y >= 0 && y < GRID_SIZE && z >= 0 && z < GRID_SIZE)
    assert(material < MATERIAL_COUNT && state < 0x1000000)
    for axis in 0 ..< 3
        assert(lower[axis] < upper[axis] && upper[axis] <= DEPTH_SCALE)
    cells[x + GRID_SIZE * (y + GRID_SIZE * z)] = Field_Cell{material = material, state = state, lower = lower, upper = upper}

proc field_put(cells: []Field_Cell, x, y, z: int, material: u32, state: u32 = 0)
    field_put_bounds(cells, x, y, z, material, state, {0, 0, 0}, {DEPTH_SCALE, DEPTH_SCALE, DEPTH_SCALE})

proc field_column(cells: []Field_Cell, axis, u, v: int, words: []u32, first_word: int) -> int
    runs: [GRID_SIZE][RUN_WORDS]u32
    count := 0
    transverse_u := (axis + 1) % 3
    transverse_v := (axis + 2) % 3
    for depth in 0 ..< GRID_SIZE
        coordinate: [3]int
        coordinate[axis] = depth
        coordinate[transverse_u] = u
        coordinate[transverse_v] = v
        cell := cells[coordinate.x + GRID_SIZE * (coordinate.y + GRID_SIZE * coordinate.z)]
        if cell.material == 0: continue
        start := u32(depth * DEPTH_SCALE) + cell.lower[axis]
        end := u32(depth * DEPTH_SCALE) + cell.upper[axis]
        run := [RUN_WORDS]u32{
            start | (end << 16),
            cell.material | (cell.state << 8),
            cell.lower[transverse_u] | (cell.lower[transverse_v] << 16),
            cell.upper[transverse_u] | (cell.upper[transverse_v] << 16),
        }
        if count > 0
            previous := runs[count - 1]
            if (previous[0] >> 16) == start && previous[1] == run[1] && previous[2] == run[2] && previous[3] == run[3]
                runs[count - 1][0] = (previous[0] & 65535) | (end << 16)
                continue
        assert(count < GRID_SIZE)
        runs[count] = run
        count += 1
    if len(words) > 0
        for i in 0 ..< count
            for j in 0 ..< RUN_WORDS: words[first_word + i * RUN_WORDS + j] = runs[i][j]
    return count

proc field_validate(f: ^Field, cells: []Field_Cell)
    # Decode every cell independently through all three packed projections.
    for cell, index in cells
        coordinate := [3]int{index % GRID_SIZE, index / GRID_SIZE % GRID_SIZE, index / (GRID_SIZE * GRID_SIZE)}
        for axis in 0 ..< 3
            u := (axis + 1) % 3
            v := (axis + 2) % 3
            column := int(f.words[1]) + 2 * (axis * GRID_SIZE * GRID_SIZE + coordinate[u] + GRID_SIZE * coordinate[v])
            first := int(f.words[column])
            count := int(f.words[column + 1])
            assert(count <= GRID_SIZE && first + count <= int(f.words[3]))
            cell_start := u32(coordinate[axis] * DEPTH_SCALE)
            cell_end := cell_start + DEPTH_SCALE
            found := false
            previous_end: u32 = 0
            for i in 0 ..< count
                at := int(f.words[2]) + (first + i) * RUN_WORDS
                start := f.words[at] & 65535
                end := f.words[at] >> 16
                assert(start < end && end <= GRID_SIZE * DEPTH_SCALE && start >= previous_end)
                previous_end = end
                if end <= cell_start || start >= cell_end: continue
                assert(!found && cell.material != 0)
                found = true
                assert(f.words[at + 1] == (cell.material | (cell.state << 8)))
                assert(max(start, cell_start) == cell_start + cell.lower[axis])
                assert(min(end, cell_end) == cell_start + cell.upper[axis])
                assert(f.words[at + 2] == (cell.lower[u] | (cell.lower[v] << 16)))
                assert(f.words[at + 3] == (cell.upper[u] | (cell.upper[v] << 16)))
            assert(found == (cell.material != 0))

proc field_pack(f: ^Field, cells: []Field_Cell, states: []Field_State, properties: []Field_Property)
    assert(len(cells) == CELL_COUNT && len(states) > 0 && len(states) < 0x1000000)
    for cell in cells
        if cell.material == 0: continue
        assert(cell.material < MATERIAL_COUNT && int(cell.state) < len(states))
        for axis in 0 ..< 3: assert(cell.lower[axis] < cell.upper[axis] && cell.upper[axis] <= DEPTH_SCALE)
    for state in states
        assert(int(state.first) <= len(properties) && int(state.count) <= len(properties) - int(state.first))
        for i in 0 ..< int(state.count)
            for j in 0 ..< i: assert(properties[int(state.first) + i].id != properties[int(state.first) + j].id)
    for property in properties: assert(property.components >= 1 && property.components <= 4)

    counts := make([]int, COLUMN_COUNT)
    defer delete(counts)
    run_count := 0
    for axis in 0 ..< 3
        for v in 0 ..< GRID_SIZE
            for u in 0 ..< GRID_SIZE
                column := axis * GRID_SIZE * GRID_SIZE + u + GRID_SIZE * v
                counts[column] = field_column(cells, axis, u, v, nil, 0)
                run_count += counts[column]

    run_offset := HEADER_WORDS + COLUMN_COUNT * 2
    material_offset := run_offset + run_count * RUN_WORDS
    state_offset := material_offset + MATERIAL_COUNT * MATERIAL_WORDS
    property_offset := state_offset + len(states) * 2
    word_count := property_offset + len(properties) * PROPERTY_WORDS
    field_destroy(f)
    f.words = make([]u32, word_count)
    f.words[0] = GRID_SIZE
    f.words[1] = HEADER_WORDS
    f.words[2] = u32(run_offset)
    f.words[3] = u32(run_count)
    f.words[4] = u32(material_offset)
    f.words[5] = MATERIAL_COUNT
    f.words[6] = u32(state_offset)
    f.words[7] = u32(len(states))
    f.words[8] = u32(property_offset)
    f.words[9] = u32(len(properties))
    f.words[10] = u32(word_count)

    first_run := 0
    for axis in 0 ..< 3
        for v in 0 ..< GRID_SIZE
            for u in 0 ..< GRID_SIZE
                column := axis * GRID_SIZE * GRID_SIZE + u + GRID_SIZE * v
                f.words[HEADER_WORDS + column * 2] = u32(first_run)
                f.words[HEADER_WORDS + column * 2 + 1] = u32(counts[column])
                written := field_column(cells, axis, u, v, f.words, run_offset + first_run * RUN_WORDS)
                assert(written == counts[column])
                first_run += written
    assert(first_run == run_count)

    for state, i in states
        f.words[state_offset + i * 2] = state.first
        f.words[state_offset + i * 2 + 1] = state.count
    for property, i in properties
        at := property_offset + i * PROPERTY_WORDS
        f.words[at] = property.id
        f.words[at + 1] = property.components
        coefficients := [4][4]f32{property.base, property.gradient_x, property.gradient_y, property.gradient_z}
        for vector, j in coefficients
            for value, k in vector: f.words[at + 4 + j * 4 + k] = transmute(u32, value)
    field_validate(f, cells)

proc material_put(f: ^Field, id: int, color: [3]f32, metallic: f32 = 0, roughness: f32 = 0.65, emission: f32 = 0)
    assert(id >= 0 && id < MATERIAL_COUNT)
    alpha: f32 = 0 if id == 0 else 1
    values := [8]f32{
        math.pow(color.r, 2.2), math.pow(color.g, 2.2), math.pow(color.b, 2.2), alpha,
        metallic, roughness, emission, 0.04,
    }
    first := int(f.words[4]) + id * MATERIAL_WORDS
    for value, i in values: f.words[first + i] = transmute(u32, value)

proc field_generate(f: ^Field)
    cells := make([]Field_Cell, CELL_COUNT)
    defer delete(cells)
    states := [3]Field_State{{0, 0}, {0, 2}, {2, 1}}
    properties := [3]Field_Property{
        {id = 1, components = 1, base = {1700, 0, 0, 0}, gradient_x = {-28, 0, 0, 0}, gradient_y = {-8, 0, 0, 0}, gradient_z = {-8, 0, 0, 0}},
        {id = 2, components = 1, base = {1.8, 0, 0, 0}, gradient_x = {-0.035, 0, 0, 0}},
        {id = 3, components = 3, base = {0.75, 1.0, 0.9, 0}, gradient_z = {0.005, -0.015, 0, 0}},
    }

    # A thin frame exposes the whole 32-cubed domain, including its exact far endpoints.
    for z in 0 ..< GRID_SIZE
        for y in 0 ..< GRID_SIZE
            for x in 0 ..< GRID_SIZE
                edges := 0
                if x == 0 || x == GRID_SIZE - 1: edges += 1
                if y == 0 || y == GRID_SIZE - 1: edges += 1
                if z == 0 || z == GRID_SIZE - 1: edges += 1
                if edges >= 2: field_put(cells, x, y, z, 1)

    # Matter accumulates near the lower body-diagonal corner; state does not change volume.
    for z in 2 ..< GRID_SIZE - 2
        for y in 2 ..< GRID_SIZE - 2
            for x in 2 ..< GRID_SIZE - 2
                depth := x + y + z
                if depth < 25: field_put(cells, x, y, z, 2)
                else if depth < 30: field_put(cells, x, y, z, 3, 1)
                else if depth == 30: field_put_bounds(cells, x, y, z, 3, 1, {0, 0, 0}, {192, 192, 192})

    # A through-channel leaves disconnected intervals instead of filling their hull.
    for z in 2 ..< 24
        for y in 7 ..< 10
            for x in 7 ..< 10: field_put(cells, x, y, z, 0)
    for x in 5 ..< 26
        if x >= 13 && x < 17: continue
        field_put_bounds(cells, x, 12, 12, 4, 2, {0, 64, 32}, {256, 224, 240})

    field_pack(f, cells, states[:], properties[:])
    for id in 0 ..< MATERIAL_COUNT
        color := [3]f32{
            0.24 + 0.70 * f32((id >> 5) & 7) / 7,
            0.24 + 0.70 * f32((id >> 2) & 7) / 7,
            0.24 + 0.70 * f32(id & 3) / 3,
        }
        material_put(f, id, color)
    material_put(f, 0, {0, 0, 0})
    material_put(f, 1, {0.24, 0.29, 0.32}, 0, 0.85)
    material_put(f, 2, {0.24, 0.28, 0.31}, 0, 0.9)
    material_put(f, 3, {0.55, 0.19, 0.06}, 0, 0.75, 0.4)
    material_put(f, 4, {0.88, 0.72, 0.28}, 0.8, 0.22)

proc field_destroy(f: ^Field)
    delete(f.words)
    f.words = nil
